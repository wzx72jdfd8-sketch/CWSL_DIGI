+static inline void waitForTimeFT2(std::shared_ptr<ScreenPrinter> printer, std::vector<std::shared_ptr<SyncPredicate>>& preds) {
+    SYSTEMTIME time;
+    int goBucket = -1;
+    bool go = false;
+    while (!syncThreadTerminateFlag) {
+        try {
+            GetSystemTime(&time);
+            const WORD s = time.wSecond;
+            const WORD ms = time.wMilliseconds;
+            int bucket = -1;
+            // 16 slots/minute at 3.75 s: 0, 3.75, 7.50, 11.25, ...
+            if ((s % 15 == 0) && ms < 200) {
+                bucket = s * 1000;
+            }
+            else if ((s == 3 || s == 18 || s == 33 || s == 48) && ms >= 750) {
+                bucket = s * 1000 + 750;
+            }
+            else if ((s == 7 || s == 22 || s == 37 || s == 52) && ms >= 500) {
+                bucket = s * 1000 + 500;
+            }
+            else if ((s == 11 || s == 26 || s == 41 || s == 56) && ms >= 250) {
+                bucket = s * 1000 + 250;
+            }
+            if (go && bucket == goBucket) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(MAX_SLEEP_MS));
+                continue;
+            }
+            go = (bucket != -1);
+            if (go) {
+                printer->print("Beginning FT2 interval...", LOG_LEVEL::DEBUG);
+                goBucket = bucket;
+                for (size_t k = 0; k < preds.size(); ++k) {
+                    preds[k]->store(true);
+                }
+            }
+            else {
+                std::this_thread::sleep_for(std::chrono::milliseconds(MIN_SLEEP_MS));
+            }
+        }
+        catch (const std::exception& e) {
+            printer->print("waitForTimeFT2", e);
+        }
+    }
+    printer->debug("FT2 Synchronization thread exiting");
 }
 
 
